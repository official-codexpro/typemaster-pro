import * as THREE from 'three';
import gsap from 'gsap';

const root = document.getElementById('typeFighterGame');
const arena = document.getElementById('gameArena');

if (!arena) {
    throw new Error('Fighting arena not found.');
}

if (!root) {
    throw new Error('Type Fighter game container not found.');
}

// Scene
const scene = new THREE.Scene();
scene.background = new THREE.Color(0x08090d);
scene.fog = new THREE.FogExp2(0x08090d, 0.025);

// Camera
const camera = new THREE.PerspectiveCamera(
    42,
    window.innerWidth / window.innerHeight,
    0.1,
    150
);

camera.position.set(0, 5.5, 15);
camera.lookAt(0, 1.5, 0);

// Renderer
const renderer = new THREE.WebGLRenderer({
    antialias: true,
    alpha: false,
    powerPreference: 'high-performance'
});

renderer.setPixelRatio(Math.min(window.devicePixelRatio, 1.5));
renderer.setSize(window.innerWidth, window.innerHeight);
renderer.shadowMap.enabled = true;
renderer.shadowMap.type = THREE.PCFSoftShadowMap;
renderer.outputColorSpace = THREE.SRGBColorSpace;
renderer.toneMapping = THREE.ACESFilmicToneMapping;
renderer.toneMappingExposure = 1.15;

renderer.domElement.id = 'fighter3DCanvas';

Object.assign(renderer.domElement.style, {
    position: 'absolute',
    inset: '0',
    width: '100%',
    height: '100%',
    zIndex: '0',
    pointerEvents: 'none'
});

arena.style.position = 'relative';
arena.style.overflow = 'hidden';
arena.appendChild(renderer.domElement);

// Lighting
scene.add(new THREE.AmbientLight(0xffffff, 0.7));

const keyLight = new THREE.DirectionalLight(0xffffff, 3);
keyLight.position.set(-5, 10, 7);
keyLight.castShadow = true;
keyLight.shadow.mapSize.set(1024, 1024);
scene.add(keyLight);

const redLight = new THREE.PointLight(0xff1744, 35, 18);
redLight.position.set(-7, 4, -3);
scene.add(redLight);

const blueLight = new THREE.PointLight(0x1677ff, 35, 18);
blueLight.position.set(7, 4, -3);
scene.add(blueLight);

// Arena floor
const floorGeometry = new THREE.PlaneGeometry(60, 60);

const floorMaterial = new THREE.MeshStandardMaterial({
    color: 0x171a22,
    roughness: 0.72,
    metalness: 0.25
});

const floor = new THREE.Mesh(floorGeometry, floorMaterial);
floor.rotation.x = -Math.PI / 2;
floor.receiveShadow = true;
scene.add(floor);

// Arena platform
const platform = new THREE.Mesh(
    new THREE.CylinderGeometry(9, 9, 0.35, 96),
    new THREE.MeshStandardMaterial({
        color: 0x252a35,
        metalness: 0.65,
        roughness: 0.35
    })
);

platform.position.y = 0.12;
platform.receiveShadow = true;
scene.add(platform);

// Arena boundary
const boundary = new THREE.Mesh(
    new THREE.TorusGeometry(8.7, 0.045, 8, 128),
    new THREE.MeshBasicMaterial({ color: 0xff263f })
);

boundary.rotation.x = Math.PI / 2;
boundary.position.y = 0.32;
scene.add(boundary);

// Background structures
const backdropMaterial = new THREE.MeshStandardMaterial({
    color: 0x111722,
    metalness: 0.7,
    roughness: 0.4
});

for (let i = 0; i < 12; i++) {
    const height = 3 + Math.random() * 5;

    const pillar = new THREE.Mesh(
        new THREE.BoxGeometry(0.65, height, 0.65),
        backdropMaterial
    );

    const angle = (i / 12) * Math.PI * 2;
    pillar.position.set(
        Math.cos(angle) * 12,
        height / 2,
        Math.sin(angle) * 12
    );

    pillar.castShadow = true;
    scene.add(pillar);
}

// Ambient arena particles
const particleCount = 350;
const particlePositions = new Float32Array(particleCount * 3);

for (let i = 0; i < particleCount; i++) {
    particlePositions[i * 3] = (Math.random() - 0.5) * 35;
    particlePositions[i * 3 + 1] = Math.random() * 10;
    particlePositions[i * 3 + 2] = (Math.random() - 0.5) * 25;
}

const particleGeometry = new THREE.BufferGeometry();
particleGeometry.setAttribute(
    'position',
    new THREE.BufferAttribute(particlePositions, 3)
);

const particles = new THREE.Points(
    particleGeometry,
    new THREE.PointsMaterial({
        color: 0xffb5a8,
        size: 0.045,
        transparent: true,
        opacity: 0.65
    })
);

scene.add(particles);

// Animation loop
const clock = new THREE.Clock();

function animate() {
    requestAnimationFrame(animate);

    const elapsed = clock.getElapsedTime();

    particles.rotation.y = elapsed * 0.015;
    boundary.material.opacity = 0.75 + Math.sin(elapsed * 2) * 0.2;

    renderer.render(scene, camera);
}

animate();

// Responsive renderer
window.addEventListener('resize', () => {
    camera.aspect = window.innerWidth / window.innerHeight;
    camera.updateProjectionMatrix();

    renderer.setSize(window.innerWidth, window.innerHeight);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 1.5));
});

console.log('Type Fighter 3D Engine initialized', THREE.REVISION);
